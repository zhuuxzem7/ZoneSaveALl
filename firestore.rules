rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoDataUrl',
          'bio',
          'preferredFilenameMode',
          'autoClipboard',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 120
        && (!('photoDataUrl' in data) || (data.photoDataUrl is string && data.photoDataUrl.size() <= 250000))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 160))
        && (!('preferredFilenameMode' in data) || (data.preferredFilenameMode is string && data.preferredFilenameMode in ['default', 'title']))
        && (!('autoClipboard' in data) || data.autoClipboard is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedMediaItem(data, userId, downloadId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'platform',
          'url',
          'title',
          'authorName',
          'uniqueId',
          'cover',
          'isFavorite',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'platform',
          'url',
          'title',
          'authorName',
          'uniqueId',
          'cover',
          'isFavorite',
          'collectionFolder',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && isValidId(data.id)
        && data.id == downloadId
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.platform is string
        && data.platform in ['tiktok', 'instagram', 'facebook', 'youtube', 'twitter', 'pinterest', 'threads', 'capcut']
        && data.url is string
        && data.url.size() <= 500
        && data.title is string
        && data.title.size() <= 300
        && data.authorName is string
        && data.authorName.size() <= 100
        && data.uniqueId is string
        && data.uniqueId.size() <= 100
        && data.cover is string
        && data.cover.size() <= 1000
        && data.isFavorite is bool
        && (!('collectionFolder' in data) || (data.collectionFolder is string && data.collectionFolder in ['Umum', 'Ide Konten', 'Sound Viral', 'Referensi']))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBugReport(data, userId, reportId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'targetUrl',
          'platform',
          'description',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'targetUrl',
          'platform',
          'description',
          'status',
          'createdAt'
        ])
        && data.id is string
        && isValidId(data.id)
        && data.id == reportId
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.targetUrl is string
        && data.targetUrl.size() <= 500
        && data.platform is string
        && data.platform.size() >= 1
        && data.platform.size() <= 32
        && data.description is string
        && data.description.size() >= 5
        && data.description.size() <= 600
        && data.status is string
        && data.status == 'open'
        && data.createdAt is timestamp;
    }

    // Owner-only user profile (PII isolation: email, avatar, bio, preferences)
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && request.auth.uid == userId;
      allow list: if false;

      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'photoDataUrl',
          'bio',
          'preferredFilenameMode',
          'autoClipboard',
          'updatedAt'
        ]);

      allow delete: if false;

      // Owner-only cloud-synced download history, favorites & folders
      match /downloads/{downloadId} {
        allow get: if isValidId(userId)
          && isValidId(downloadId)
          && isSignedIn()
          && request.auth.uid == userId;

        allow list: if isValidId(userId)
          && isSignedIn()
          && request.auth.uid == userId
          && resource.data.userId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(downloadId)
          && isVerifiedOwner(userId)
          && isValidSavedMediaItem(incoming(), userId, downloadId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && isValidId(downloadId)
          && isVerifiedOwner(userId)
          && isValidSavedMediaItem(incoming(), userId, downloadId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'url',
            'title',
            'authorName',
            'uniqueId',
            'cover',
            'isFavorite',
            'collectionFolder',
            'updatedAt'
          ]);

        allow delete: if isValidId(userId)
          && isValidId(downloadId)
          && isVerifiedOwner(userId);
      }

      // Owner-only submitted broken-link & bug reports
      match /reports/{reportId} {
        allow get: if isValidId(userId)
          && isValidId(reportId)
          && isSignedIn()
          && request.auth.uid == userId;

        allow list: if isValidId(userId)
          && isSignedIn()
          && request.auth.uid == userId
          && resource.data.userId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(reportId)
          && isVerifiedOwner(userId)
          && isValidBugReport(incoming(), userId, reportId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().createdAt == request.time;

        allow update: if false;

        allow delete: if isValidId(userId)
          && isValidId(reportId)
          && isVerifiedOwner(userId);
      }
    }
  }
}
